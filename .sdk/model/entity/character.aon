red\":[\"id\",\"title\"],\"type\":\"object\"},\"type\":{\"description\":\"The character's role in the episode.\",\"enum\":[\"RECURRING\",\"GUEST\",\"MAIN\"],\"type\":\"string\"}},\"required\":[\"type\",\"episode\"],\"type\":\"object\"},\"type\":\"array\"},\"firstAppearance\":{\"description\":\"Title of the episode the character first appeared in.\",\"nullable\":true,\"type\":\"string\"},\"gender\":{\"description\":\"The character's gender.\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Unique identifier for the character.\",\"type\":\"number\"},\"job\":{\"description\":\"List of jobs the character has.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"lastAppearance\":{\"description\":\"Title of the last episode the character appeared in.\",\"nullable\":true,\"type\":\"string\"},\"marital\":{\"description\":\"The character's marital status.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The character's name.\",\"type\":\"string\"},\"workplace\":{\"description\":\"List of locations a character has worked at.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"gender\",\"marital\",\"job\",\"workplace\",\"firstAppearance\",\"lastAppearance\",\"actor\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"results\",\"meta\"],\"type\":\"object\"}}},\"description\":\"200\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
